rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Keep emails in sync with frontend/src/app/constants/allowed-users.ts
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ekirastogi@gmail.com', 'shivisingh2996@gmail.com'];
    }

    // Firestore is worker-eventing only — all app data lives in Supabase Postgres.

    match /worker/status {
      allow read: if isOwner();
      allow write: if false;
    }

    match /worker/listen {
      allow read: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.active == true
        && request.resource.data.until is int
        && request.resource.data.requestedBy == request.auth.uid;
      allow delete: if false;
    }

    match /workerJobs/{jobId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == request.auth.uid
        && (
          request.resource.data.type == 'hot_ingest'
          || request.resource.data.type == 'seed_universe'
          || (
            request.resource.data.type == 'symbol_ingest'
            && request.resource.data.symbol is string
            && request.resource.data.symbol.size() > 0
            && request.resource.data.symbol.size() <= 32
          )
        );
      allow update, delete: if false;
    }

    // Per-user settings (encrypted contract-note password, etc.)
    match /userConfig/{uid} {
      allow read, create, update, delete: if isOwner() && request.auth.uid == uid;
    }
  }
}
