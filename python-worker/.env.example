# Copy to python-worker/.env (never commit). Groww + cloud DB can also
# be inherited from ../backend/.env.

# Local Docker Postgres (docker compose up -d)
LOCAL_PG_HOST=127.0.0.1
LOCAL_PG_PORT=5433
LOCAL_PG_DB=kairo_market
LOCAL_PG_USER=kairo
LOCAL_PG_PASSWORD=kairo

# Groww Trade API
GROWW_API_KEY=
GROWW_API_SECRET=
# GROWW_TOTP=
# GROWW_ACCESS_TOKEN=

# Whose TradeBook to track (Firebase uid)
KAIRO_USER_ID=

LIVE_POLL_SECONDS=8
HISTORY_ON_START=true
PORT=8765
