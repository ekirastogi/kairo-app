{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/ensure-firebase-config.js && node scripts/ensure-supabase-config.js",
    "start": "ng serve",
    "prebuild": "node scripts/ensure-firebase-config.js && node scripts/ensure-supabase-config.js",
    "build": "ng build",
    "prebuild:firebase": "node scripts/ensure-firebase-config.js --from-secrets && node scripts/ensure-supabase-config.js --from-env",
    "build:firebase": "ng build --configuration production",
    "predeploy": "node scripts/ensure-firebase-config.js --from-secrets && node scripts/ensure-supabase-config.js --from-env",
    "deploy": "npm run build:firebase && firebase deploy --only hosting",
    "deploy:hosting": "ng build --configuration production && firebase deploy --only hosting",
    "secrets:setup": "node scripts/setup-firebase-secrets.js",
    "secrets:fetch": "node scripts/ensure-firebase-config.js --from-secrets",
    "firebase:setup": "node scripts/setup-firebase.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/fire": "^17.1.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "chart.js": "^4.5.1",
    "firebase": "^10.14.1",
    "lightweight-charts": "^5.2.1",
    "pdfjs-dist": "^4.10.38",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.5",
    "@angular-eslint/builder": "^17.5.3",
    "@angular-eslint/eslint-plugin": "^17.5.3",
    "@angular-eslint/eslint-plugin-template": "^17.5.3",
    "@angular-eslint/schematics": "^17.5.3",
    "@angular-eslint/template-parser": "^17.5.3",
    "@angular/cli": "^17.3.5",
    "@angular/compiler-cli": "^17.3.0",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.4.2"
  }
}
